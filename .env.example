# Copy to .env and fill in values before running the app.

# Local dev: use Render Postgres external URL, or a local Postgres instance.
# Production (Render): set automatically when you link shelfi-db to the web service.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/shelfi_db"

# Google Gemini API key for shelf image analysis
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Optional Gemini tuning (defaults shown)
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_MEDIA_RESOLUTION=high
GEMINI_THINKING_LEVEL=high
